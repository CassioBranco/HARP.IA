NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# IA — geração de texto (Claude)
ANTHROPIC_API_KEY=
# IA — embeddings p/ RAG (knowledge_vault). text-embedding-3-small (1536 dims).
# Sem esta chave, a geração funciona normal, só SEM o conhecimento E-E-A-T do cliente.
OPENAI_API_KEY=
# Loja do cliente — Mercado Pago (Checkout Pro). Sem o token, o checkout desliga
# graciosamente. Doc: mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook (painel MP → Webhooks → "Chave secreta").
# Diferente do access token. Sem ele, a validação de origem do webhook é pulada
# (o re-fetch autenticado ainda protege o status). Defina em produção.
MERCADOPAGO_WEBHOOK_SECRET=
# Notificações por e-mail ao dono (lead/agendamento/pedido) via Resend.
# DORMENTE: sem a chave, nada é enviado e nada quebra. Ligue em produção.
RESEND_API_KEY=
# Remetente das notificações (precisa de domínio verificado no Resend).
RESEND_FROM=ANCOREO <nao-responda@ancoreo.com.br>
