{
  "model": "claude-opus-5",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git checkout -b *)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(supabase*)",
      "Bash(vercel*)",
      "Bash(node*)",
      "Bash(tsc*)",
      "Bash(vitest*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(npm publish*)",
      "Bash(vercel --prod*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(rm -rf*)",
      "Bash(npm install --global*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(eval*)"
    ]
  },
  "env": {
    "PROJECT_CODENAME": "ANCOREO",
    "MVP_ESCOPO": "onboarding, site builder, blog builder, metricas SEO/GEO/AEO, Google Perfil de Empresa. E-commerce FORA.",
    "MVP_LANCAMENTO": "2026-09-01",
    "FONTE_DA_VERDADE": "ESTADO.md (gerado por scripts/estado.mjs) > MVP.md > RITUAL.md > CLAUDE.md",
    "AUTONOMY_LEVEL": "autonomous",
    "PORTOES_HUMANOS": "texto que vai ao cliente, qualidade do que a IA escreveu, numero novo na interface, fim de sprint, lancar"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  }
}